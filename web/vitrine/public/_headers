# En-têtes HTTP pour Cloudflare Pages (voir docs/08-referencement.md).

# Fichiers techniques de Next.js : ce ne sont pas des pages, Google ne doit pas les indexer.
/*.txt
  X-Robots-Tag: noindex

# Sauf robots.txt, qui doit rester lisible par les moteurs.
/robots.txt
  ! X-Robots-Tag

# Fichiers versionnés (leur nom change à chaque build) : cache long.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
