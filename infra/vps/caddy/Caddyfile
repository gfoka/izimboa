# Certificats HTTPS automatiques (Let's Encrypt) pour chaque domaine ci-dessous.
{
	email {$ACME_EMAIL:admin@izimboa.com}
}

(securite) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	encode zstd gzip
}

# Espace vendeur Izimboa Delivery (application web statique, déployée par deploy-delivery-web.yml).
# Application connectée : jamais référencée.
delivery.izimboa.com {
	import securite
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://api.izimboa.com https://auth.izimboa.com; frame-src https://auth.izimboa.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://auth.izimboa.com"
	}
	root * /srv/apps/delivery
	# Fichiers versionnés : cache long. Pages : toujours revalidées.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	@pages not path /_next/static/*
	header @pages Cache-Control "no-cache"
	# Lien de suivi du destinataire : /suivi/<jeton>/ → une seule page qui lit le jeton.
	@suivi path_regexp ^/suivi/[A-Za-z0-9_-]+/?$
	rewrite @suivi /suivi/index.html
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

# Sites produits pas encore ouverts : page « bientôt disponible », exclue de Google.
go.izimboa.com, fly.izimboa.com, buy.izimboa.com {
	import securite
	header X-Robots-Tag "noindex"
	root * /srv/site/bientot
	try_files {path} /index.html
	file_server
}

# API commune à tous les produits (Spring Boot).
api.izimboa.com {
	import securite
	header X-Robots-Tag "noindex"
	# Contrôle de santé public et court.
	handle /health {
		rewrite * /actuator/health
		reverse_proxy api:8080
	}
	# Le reste de /actuator n'est jamais exposé sur Internet.
	handle /actuator/* {
		respond 404
	}
	# Documentation de l'API : pas publique en production (la carte des points d'entrée aide les attaquants).
	handle /v3/api-docs* {
		respond 404
	}
	handle /swagger-ui* {
		respond 404
	}
	handle {
		reverse_proxy api:8080
	}
}

# Connexion centrale (Keycloak).
auth.izimboa.com {
	import securite
	header X-Robots-Tag "noindex"
	# Les points de gestion internes de Keycloak ne sont pas exposés.
	handle /metrics* {
		respond 404
	}
	handle /health* {
		respond 404
	}
	handle {
		reverse_proxy keycloak:8080
	}
}
