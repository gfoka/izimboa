# Certificats HTTPS automatiques (Let's Encrypt) pour chaque domaine ci-dessous.
{
	email {$ACME_EMAIL:admin@izimboa.com}
}

(securite) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	encode zstd gzip
}

# Sites produits : page « bientôt disponible », exclue de Google tant que le produit n'est pas lancé.
delivery.izimboa.com, go.izimboa.com, fly.izimboa.com, buy.izimboa.com {
	import securite
	header X-Robots-Tag "noindex"
	root * /srv/site/bientot
	try_files {path} /index.html
	file_server
}

# API commune à tous les produits (Spring Boot).
api.izimboa.com {
	import securite
	header X-Robots-Tag "noindex"
	# Contrôle de santé public et court.
	handle /health {
		rewrite * /actuator/health
		reverse_proxy api:8080
	}
	# Le reste de /actuator n'est jamais exposé sur Internet.
	handle /actuator/* {
		respond 404
	}
	handle {
		reverse_proxy api:8080
	}
}

# Connexion centrale (Keycloak).
auth.izimboa.com {
	import securite
	header X-Robots-Tag "noindex"
	# Les points de gestion internes de Keycloak ne sont pas exposés.
	handle /metrics* {
		respond 404
	}
	handle /health* {
		respond 404
	}
	handle {
		reverse_proxy keycloak:8080
	}
}
